# ── NeonDB (PostgreSQL) Database ──────────────────────────────────────────
DATABASE_URL="postgresql://neondb_owner:YOUR_NEONDB_PASSWORD@YOUR_EP_HOST.neon.tech/neondb?sslmode=require"

# ── Admin CRM Credentials ──────────────────────────────────────────────────
ADMIN_EMAIL="admin@rowellblanca.dev"
ADMIN_PASSWORD="YourSecureAdminPasswordHere!"

# ── Mailtrap SMTP Email Services ───────────────────────────────────────────
MAILTRAP_HOST="sandbox.smtp.mailtrap.io"
MAILTRAP_PORT="2525"
MAILTRAP_USER="your_mailtrap_user"
MAILTRAP_PASS="your_mailtrap_password"

# ── Web3Forms Fallback ──────────────────────────────────────────────────────
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY="your_web3forms_access_key"
