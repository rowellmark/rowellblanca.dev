# ── NeonDB (PostgreSQL) Database ──────────────────────────────────────────
DATABASE_URL="postgresql://neondb_owner:YOUR_NEONDB_PASSWORD@YOUR_EP_HOST.neon.tech/neondb?sslmode=require"

# ── Admin CRM Credentials ──────────────────────────────────────────────────
ADMIN_EMAIL="admin@rowellblanca.dev"
ADMIN_PASSWORD="YourSecureAdminPasswordHere!"

# ── Vercel Blob (file uploads, app/api/upload/route.ts) ────────────────────
# Enable a Blob store in the Vercel dashboard (Storage tab) to get this token.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ── Contact Form Delivery (Primary: Resend) ────────────────────────────────
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="no-reply@rowellblanca.dev"
RESEND_FROM_NAME="Rowell Mark Blanca"

# ── Generic SMTP / Production Mail Provider ────────────────────────────────
# Prefer these if you want to use SMTP instead of Resend.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
CONTACT_FROM_EMAIL="no-reply@rowellblanca.dev"
CONTACT_TO_EMAIL="rowellblanca94@gmail.com"

# ── Optional Web3Forms Fallback (unused by default) ────────────────────────
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=""

# ── Google Analytics, Tag Manager & SEO Verification ───────────────────────
# Google Analytics 4 (GA4) Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=""

# Google Tag Manager (GTM) Container ID (e.g. GTM-XXXXXXXX)
NEXT_PUBLIC_GTM_ID=""

# Google Search Console Verification Meta Tag Content String
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

